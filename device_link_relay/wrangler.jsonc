{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dingdong-device-link-dev",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "dingdong.xn--m8txu.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../docs",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*"]
  },
  "d1_databases": [
    {
      "binding": "TELEMETRY_DB",
      "database_name": "dingdong-lifecycle-telemetry",
      "database_id": "da226343-848d-4469-9600-6085163b86fa",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_ROOMS",
        "class_name": "RelayRoom"
      }
    ]
  },
  "exports": {
    "RelayRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
